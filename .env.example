# Skopíruj tento súbor ako .env a doplň kľúč k providerovi, ktorého chceš použiť.
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
#
# Kód sa nemení — meníš iba MODEL a príslušný API kľúč.

# --- OpenRouter (predvolené, model zadarmo) ----------------------------------
# Registrácia: https://openrouter.ai/keys
MODEL=openrouter/google/gemma-4-31b-it:free
OPENROUTER_API_KEY=<VLOZ_KLUC_SEM>

# --- OpenAI ------------------------------------------------------------------
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=<VLOZ_KLUC_SEM>

# --- Anthropic ---------------------------------------------------------------
# MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=<VLOZ_KLUC_SEM>

# --- Google Gemini -----------------------------------------------------------
# MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=<VLOZ_KLUC_SEM>

# --- Lokálne modely (bez kľúča, treba API_BASE) ------------------------------
# LM Studio:
# MODEL=openai/google/gemma-4-e4b
# API_BASE=http://localhost:1234/v1
#
# Ollama:
# MODEL=ollama/llama3.2
# API_BASE=http://localhost:11434

# --- Voliteľné ---------------------------------------------------------------
# Maximálny počet kôl cyklu LLM → nástroje → LLM (poistka proti zacykleniu).
# MAX_ITERACII=8
